{
	"env": {
		"browser": true,
		"es2022": true,
		"node": true
	},
	"parserOptions": {
		"ecmaVersion": 2022,
		"sourceType": "script",
		"ecmaFeatures": { "globalReturn": false }
	},
	"rules": {
		"no-unreachable": "error",
		"no-unused-vars": [
			"warn",
			{
				"args": "none",
				"vars": "local"
			}
		],
		"no-dupe-class-members": "error",
		"no-fallthrough": "error",
		"no-self-assign": "error"
	},
	"ignorePatterns": [
		"js/vendor/**",
		"js/workers/gif.worker.js",
		"js/generated/**",
		"node_modules/**"
	]
}
