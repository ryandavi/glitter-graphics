{
	"token date": {
		"scope": "html",
		"prefix": "{date",
		"body": "{date:${1:2001-06-07}|${2:7 June 2001}}",
		"description": "A date: ISO value, then visible text"
	},
	"token y": {
		"scope": "html",
		"prefix": "{y",
		"body": "{y:${1:2001}}",
		"description": "A bare year"
	},
	"token file": {
		"scope": "html",
		"prefix": "{file",
		"body": "{file:${1:FB12.gif}}",
		"description": "A file name"
	},
	"token dir": {
		"scope": "html",
		"prefix": "{dir",
		"body": "{dir:${1:/BAR}}",
		"description": "A directory name"
	},
	"token page": {
		"scope": "html",
		"prefix": "{page",
		"body": "{page:${1:TOOLS.html}}",
		"description": "A page file name"
	},
	"token tip": {
		"scope": "html",
		"prefix": "{tip",
		"body": "{tip:${1:Explanation}}${2:term}{/tip}",
		"description": "A tooltip on a term that is not an entity"
	},
	"token link": {
		"scope": "html",
		"prefix": "{link",
		"body": "{link:${1|external,archive-wayback,archive-index,archive-mirror,archive-service,historical-snapshot|}|${2:https://}}${3:text}{/link}",
		"description": "A link"
	},
	"token dead": {
		"scope": "html",
		"prefix": "{dead",
		"body": "{dead:${1|page-offline,host-closed,domain-repurposed,service-closed|}|href=${2:http://}|tip=${3:Offline: this site no longer exists}}${4:text}{/dead}",
		"description": "A link to a page that is gone"
	},
	"token goto": {
		"scope": "html",
		"prefix": "{goto",
		"body": "{goto:${1:HeadingId}}${2:text}{/goto}",
		"description": "A link to a heading on this page"
	},
	"token open": {
		"scope": "html",
		"prefix": "{open",
		"body": "{open:${1:historyModal}}${2:text}{/open}",
		"description": "A link that opens another modal"
	},
	"token tag-later": {
		"scope": "html",
		"prefix": "{tag-later",
		"body": "{?${1:Name}}",
		"description": "Mark a name to tag as an entity later"
	},
	"token todo-cite": {
		"scope": "html",
		"prefix": "{todo-cite",
		"body": "[@todo: ${1:what source is needed}]",
		"description": "A missing citation"
	},
	"token references": {
		"scope": "html",
		"prefix": "{references",
		"body": "{references}",
		"description": "The numbered references list"
	},
