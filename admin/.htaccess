# ============================================================
# LOCAL ADMIN ACCESS
# Sessions, CSRF checks and login rate limits protect the application.
# Restrict the whole /admin directory to local requests as an additional boundary.
#
# If you use the admin remotely on production, replace this
# with HTTP Basic Auth before deploying:
#   AuthType Basic
#   AuthName "Glitter Admin"
#   AuthUserFile /path/outside/webroot/.htpasswd
#   Require valid-user
# (Generate .htpasswd with: htpasswd -c /path/.htpasswd yourname)
# The permanent fix is application-level session authentication and CSRF protection.
# ============================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require local
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    Allow from 127.0.0.1 ::1
</IfModule>
